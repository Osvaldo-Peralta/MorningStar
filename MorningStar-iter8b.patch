+                    <span className="font-mono text-xs text-white truncate" title={s.deviceFingerprint}>
+                      {s.deviceFingerprint.slice(0, 12)}…
+                    </span>
+                    {isCurrent && (
+                      <span data-testid="current-device-badge"
