{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "baseUrl": ".",
    "paths": {
      "@morningstar/core": ["packages/coreages/core"],
      "@morningstar/photo-feed": ["packages/photo-feed"],
      "@morningstar/runtime-logger": ["packages/runtime-logger"]
    },

    "rootDir": ".",
    "outDir": "dist",
    "declaration": true,
    "sourceMap": true
  },
  "include": [
    "packages/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "apps/web"
  ]
}