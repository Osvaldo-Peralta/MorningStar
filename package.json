{
  "name": "morningstar",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rimraf dist packages/core/dist packages/photo-feed/dist packages/runtime-logger/dist packages/persistence-node/dist apps/web/dist",
    "bootstrap": "npm run build && node dist/bootstrap.js",
    "test": "vitest run",
    "dev": "vitest",
    "web:dev": "npm run dev -w web",
    "web:build": "npm run build -w web",
    "web:preview": "npm run preview -w web"
  },
  "devDependencies": {
    "@types/node": "^25.1.0",
    "fake-indexeddb": "^6.2.6",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
